# Copy to /etc/junglelaw-admin-dashboard/dashboard.env on an authorized
# Alibaba Cloud staging host, then replace paths only where the approved
# production/deployment/aliyun-profile.yaml requires it. This file contains no
# credentials. Never add an Owner password, token, private key, or cookie here.

NODE_ENV=production
ZHANCHENG_DASHBOARD_HOST=0.0.0.0
ZHANCHENG_DASHBOARD_PORT=8443

# Read-only, server-generated, sanitized projections. The dashboard must never
# read player_accounts.json or any other authoritative credential/account store.
ZHANCHENG_DASHBOARD_SNAPSHOT_PATH=/var/lib/junglelaw/admin_exports/dashboard_snapshot.json
ZHANCHENG_DASHBOARD_ACCOUNT_SNAPSHOT_PATH=/var/lib/junglelaw/admin_exports/admin_accounts_snapshot.json

# Mutable dashboard authentication/audit state. systemd StateDirectory creates
# this directory as junglelaw-admin with mode 0700.
ZHANCHENG_DASHBOARD_STATE_DIR=/var/lib/junglelaw-admin-dashboard

# The dashboard may create commands only in pending. The game server consumes
# pending and writes sanitized receipts to processed or failed.
ZHANCHENG_DASHBOARD_COMMAND_ROOT=/var/lib/junglelaw/admin_commands

# Node serves HTTPS directly. Install the private key outside the release tree,
# owned by root:junglelaw-admin with mode 0640; do not commit key material.
ZHANCHENG_DASHBOARD_TLS_KEY_PATH=/etc/junglelaw-admin-dashboard/tls/privkey.pem
ZHANCHENG_DASHBOARD_TLS_CERT_PATH=/etc/junglelaw-admin-dashboard/tls/fullchain.pem
