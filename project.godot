; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="丛林法则"
run/main_scene="res://scenes/bootstrap.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://assets/branding/app_icon_1024.png"
boot_splash/bg_color=Color(0.925, 0.741, 0.376, 1)
boot_splash/show_image=true
boot_splash/image="res://assets/branding/loading_portrait_1080x1920.png"
boot_splash/stretch_mode=1
boot_splash/use_filter=true
boot_splash/minimum_display_time=1000

[autoload]

ConfigDB="*res://scripts/core/config_db.gd"
GameAudio="*res://scripts/app/systems/game_audio.gd"
OnlineRoom="*res://scripts/network/online_room.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[network]

server_host="106.15.61.103"
server_port=24567

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/vram_compression/import_etc2_astc=true
