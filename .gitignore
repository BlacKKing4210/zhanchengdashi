# OS and editors
.DS_Store
Thumbs.db
desktop.ini
~$*
.idea/
.vscode/
*.swp
*.swo

# Logs and temp
*.log
tmp/
.cache/

# Python tooling
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/

# Node tooling
node_modules/
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
build/
builds/
dist/
release/
releases/

# Godot generated files
.godot/
/android/
.import/
export.cfg
export_presets.cfg

# Godot imports CSV files as translations by default. The source CSV
# config tables are versioned, but these generated import products are not.
config/tables/*.csv.import
config/tables/*.translation
assets/ui/formal_arcade/**/*.import
assets/art/buildings/defense_towers/*.import
output/diagrams/*.import
output/formal_page_options/*.import
output/**/*.import

# Unity generated files
Library/
Temp/
Obj/
Logs/
UserSettings/
MemoryCaptures/

# Unreal generated files
Binaries/
DerivedDataCache/
Intermediate/
Saved/
*.sln
*.VC.db
*.opensdf
*.sdf

# Project-specific temp policy must follow the generic Unreal Temp/ rule above.
# Keep the Godot scan-boundary sentinel while ignoring all temporary contents.
!temp/
temp/*
!temp/.gdignore
